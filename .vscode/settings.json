    "**/dist/**": true,
    "**/.git/**": true,
    "**/public/assets/**": true,
    "**/public/draco/**": true,
    "**/public/fonts/**": true,
    "**/*.min.js": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
