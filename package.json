{
  "name": "white-rabbit",
  "version": "1.0.0",
  "description": "Interactive 3D solar system simulator with accurate celestial mechanics and real star positions",
  "main": "src/main.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:s2-renderer": "esbuild src/systems/lod/S2TilesRenderer.ts --bundle --outfile=scripts/texture-pipeline/S2TilesRenderer.bundle.js --format=esm --target=es2020 --external:three --external:3d-tiles-renderer",
    "preview": "vite preview",
    "deploy": "tsc --noEmit && vite build && gh-pages -d dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "keywords": [
    "solar-system",
    "simulator",
    "astronomy",
    "three.js",
    "space",
    "planets",
    "celestial-mechanics",
    "3d",
    "visualization",
    "astronomy-engine"
  ],
  "author": "IraGraves",
  "homepage": "https://iragraves.github.io/white-rabbit/",
  "repository": {
    "type": "git",
    "url": "https://github.com/IraGraves/white-rabbit.git"
  },
  "bugs": {
    "url": "https://github.com/IraGraves/white-rabbit/issues"
  },
  "license": "GPL-3.0",
  "type": "module",
  "dependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "3d-tiles-renderer": "^0.4.19",
    "astronomy-engine": "^2.1.19",
    "draco3dgltf": "^1.5.7",
    "lil-gui": "^0.21.0",
    "stats.js": "^0.17.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/stats.js": "^0.17.4",
    "@types/three": "^0.174.0",
    "gh-pages": "^6.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "overrides": {
    "esbuild": "0.25.0"
  }
}
